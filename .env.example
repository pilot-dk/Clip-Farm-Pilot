# Required for a public web deployment. Use a long, unique password.
CLIPPILOT_WEB_PASSWORD=replace-this-with-a-private-password

# Generate with: openssl rand -hex 32
CLIPPILOT_SESSION_SECRET=replace-this-with-a-long-random-value

# Web containers should delete working VOD copies instead of using a desktop Trash folder.
CLIPPILOT_DELETE_PERMANENT=1
CLIPPILOT_STORAGE_DIR=/tmp/clippilot
